{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Fenêtre principale : uniquement les commandes applicatives nécessaires, aucune permission de plugin.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-ack",
    "allow-ssh-host-key-decision",
    "allow-ssh-close",
    "allow-ssh-pick-key-file",
    "allow-open-external-url",
    "allow-ssh-connect-host",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-change-password",
    "allow-vault-touch",
    "allow-vault-watch",
    "allow-vault-set-auto-lock",
    "allow-vault-snapshot",
    "allow-host-save",
    "allow-host-delete",
    "allow-group-save",
    "allow-group-delete",
    "allow-identity-save",
    "allow-identity-delete",
    "allow-key-import",
    "allow-key-rename",
    "allow-key-delete",
    "allow-known-host-list",
    "allow-known-host-delete",
    "allow-settings-get",
    "allow-settings-set"
  ]
}
